PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/tajira?appName=Cluster0
# Use the same MONGODB_URI on Render and locally so dashboard + mobile share one catalog.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d
APP_NAME=Tajira Kenya
TZ=Africa/Nairobi
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tajira.vercel.app
PUBLIC_BASE_URL=http://localhost:4000
# Set SEED_DEMO=true only if you want demo products/customers on an empty database.
SEED_DEMO=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tajira
# Live Pesapal merchant keys from https://www.pesapal.com (API Keys).
# Sandbox keys only work with PESAPAL_ENV=sandbox.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=live
# Set PUBLIC_BASE_URL to the deployed API (https://…) so Pesapal can reach /payments/pesapal/ipn
# Then run: npm run pesapal:setup  and paste the printed PESAPAL_IPN_ID here.
PESAPAL_IPN_ID=
# Beem Africa SMS — https://beem.africa (Profile → API keys). Sender ID must be approved.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=TAJIRA
# Optional fallbacks. Admins should set these in Dashboard → Settings → Notifications.
SMS_ADMIN_PHONES=
SMS_SALES_PHONES=
SMS_SUPPORT_PHONE=
