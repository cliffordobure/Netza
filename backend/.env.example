PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/netza?appName=Cluster0
# Use the same MONGODB_URI on Render and locally so dashboard + mobile share one catalog.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d
APP_NAME=NETZA Kenya
TZ=Africa/Nairobi
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://netza.vercel.app
PUBLIC_BASE_URL=http://localhost:4000
# Set SEED_DEMO=true only if you want demo products/customers on an empty database.
SEED_DEMO=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=netza
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_IPN_ID=
